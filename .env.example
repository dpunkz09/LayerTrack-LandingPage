# ── Dev server ────────────────────────────────────────────────────
# Port the Astro dev server listens on (default: 4321)
PORT=4321

# ── APK release metadata ──────────────────────────────────────────
# Update these after each new release. Prefix PUBLIC_ so Astro
# exposes them to the component layer via import.meta.env.
PUBLIC_APK_URL=https://github.com/dpunkz09/LayerTrack/releases/download/poultry/LayerTrack.v1.0.apk
PUBLIC_APK_NAME=LayerTrack.v1.0.apk
PUBLIC_APP_VERSION=1.0
PUBLIC_APP_SIZE=15.1 MB
